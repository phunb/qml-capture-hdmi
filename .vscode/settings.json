{
  "files.associations": {
    "*.qml": "qml",
    "*.qrc": "xml"
  },
  "editor.multiCursorModifier": "alt",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "C_Cpp.intelliSenseEngine": "disabled",
  "qt-core.qtInstallationRoot": "C:/Qt",
  "qt-core.additionalQtPaths": [
    "C:/Qt/6.8.3/mingw_64/bin/qtpaths6.exe"
  ],
  "qt-qml.qmlls.enabled": true,
  "qt-qml.qmlls.customExePath": "C:/Qt/6.8.3/mingw_64/bin/qmlls.exe",
  "qt-qml.qmlls.customArgs": [
    "--build-dir",
    "${workspaceFolder}/build"
  ],
  "qt-qml.qmlls.additionalImportPaths": [
    "${workspaceFolder}/qml",
    "${workspaceFolder}/build",
    "C:/Qt/6.8.3/mingw_64/qml"
  ],
  "qt-qml.qmlls.useNoCMakeCalls": true,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": true,
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--header-insertion=never",
    "--background-index",
    "--clang-tidy=false"
  ],
  "clangd.fallbackFlags": [
    "-std=c++17",
    "-DAPP_VERSION=\"1.0.0\"",
    "-I${workspaceFolder}/src"
  ],
  "clangd.onConfigChanged": "restart"
}
